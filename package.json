{
  "name": "refer-zo-bootstrap",
  "version": "0.2.0",
  "private": false,
  "description": "Portable REFER bootstrap for Zo — installs skills, personas, rules, and REFER.OS law from a cloned GitHub repo.",
  "type": "module",
  "bin": {
    "refer-zo-bootstrap": "./tools/vipc-bootstrap.mjs",
    "refer-zo-mcp": "./tools/zo-mcp.mjs"
  },
  "scripts": {
    "check": "node --check tools/vipc-bootstrap.mjs && node --check tools/zo-mcp.mjs",
    "bootstrap": "node tools/vipc-bootstrap.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lightedcandle/refer-zo-bootstrap.git"
  },
  "homepage": "https://github.com/lightedcandle/refer-zo-bootstrap",
  "keywords": ["refer", "zo", "bootstrap", "skills", "vipc", "agent", "governance"],
  "license": "MIT",
  "files": [
    "AGENTS.md",
    "docs/",
    "law/",
    "skills/",
    "tools/",
    "refer-install-state.json"
  ]
}
