{
  "name": "chat-logs",
  "id": "chat-logs",
  "version": "1.0.0",
  "description": "Logs every heartbeat tick and what each train car did. Primary health monitor for the heartbeat train.",
  "keywords": ["heartbeat", "logs", "train", "health"],
  "resources": [
    { "path": "data.duckdb", "name": "logs", "format": "duckdb", "schema": "logs" }
  ],
  "schemas": {
    "logs": {
      "fields": [
        { "name": "id",            "type": "string",  "description": "Log entry ID, format: tick_<runs>_<timestamp>" },
        { "name": "session_id",     "type": "string",  "description": "Heartbeat session identifier" },
        { "name": "tick_at",       "type": "string",  "description": "ISO 8601 timestamp of tick" },
        { "name": "cars_run",      "type": "string",  "description": "Comma-separated car IDs that ran this tick (e.g. 01-dashboard,02-spawn-worker)" },
        { "name": "outcome",       "type": "string",  "description": "ok | partial | error" },
        { "name": "duration_ms",   "type": "integer", "description": "Total tick duration in milliseconds" }
      ]
    }
  },
  "metadata": {
    "created_at": "2026-04-28",
    "maintained_by": "heartbeat.mjs",
    "read_by": ["talkback.mjs", "hive/api.mjs"]
  }
}
