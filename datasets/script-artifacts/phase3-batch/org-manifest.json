{
  "entity": "Organization",
  "route": "/dashboard/organizations",
  "slug": "org",
  "label": "Church",
  "field_count": 9,
  "fields": [
    "name",
    "type",
    "region",
    "status",
    "leader",
    "leaderTitle",
    "email",
    "phone",
    "address"
  ],
  "state_var": "const [showOrganizationModal, setShowOrganizationModal] = useState(false);\n  const [editTarget, setEditTarget] = useState(null);",
  "functions": "  function openCreateOrganization() {\n    setEditTarget(null);\n    setShowOrganizationModal(true);\n  }\n  function openEditOrganization(item) {\n    setEditTarget(item);\n    setShowOrganizationModal(true);\n  }\n  function closeOrganizationModal() {\n    setShowOrganizationModal(false);\n    setEditTarget(null);\n  }",
  "button": "<button onClick={openCreateOrganization} className=\"bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition\">+ Add Church</button>",
  "modal_jsx": "{/* --- PHASE3_MODAL:org:START --- */}\n      {showOrganizationModal && (\n        <div className=\"fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4\">\n          <div className=\"bg-zinc-900 border border-zinc-700 rounded-xl w-full max-w-lg max-h-[90vh] overflow-y-auto\">\n            <div className=\"flex items-center justify-between p-4 border-b border-zinc-700\">\n              <h2 className=\"text-lg font-semibold text-white\">{editTarget ? \"Edit Church\" : \"Add Church\"}</h2>\n              <button onClick={closeOrganizationModal} className=\"text-zinc-400 hover:text-white text-xl\">x</button>\n            </div>\n            <form onSubmit={(e) => { e.preventDefault(); closeOrganizationModal(); }} className=\"p-4\">\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Church Name *</label>\n      <input type=\"text\" id=\"field-name\" name=\"name\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"e.g. Antioch Fellowship\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Church Type</label>\n      <select id=\"field-type\" name=\"type\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\">\n        <option value=\"\">Select...</option>\n        <option value=\"Local Church\">Local Church</option>\n        <option value=\"Mission Church\">Mission Church</option>\n        <option value=\"Chapel\">Chapel</option>\n        <option value=\"Plant\">Plant</option>\n        <option value=\"Satellite\">Satellite</option>\n      </select>\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Region / District</label>\n      <input type=\"text\" id=\"field-region\" name=\"region\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"e.g. Northeast Region\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Status</label>\n      <select id=\"field-status\" name=\"status\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\">\n        <option value=\"\">Select...</option>\n        <option value=\"Active\">Active</option>\n        <option value=\"Prospect\">Prospect</option>\n        <option value=\"On-Hold\">On-Hold</option>\n        <option value=\"Inactive\">Inactive</option>\n      </select>\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Senior Pastor / Leader</label>\n      <input type=\"text\" id=\"field-leader\" name=\"leader\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"e.g. Bishop James\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Leader Title</label>\n      <select id=\"field-leaderTitle\" name=\"leaderTitle\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\">\n        <option value=\"\">Select...</option>\n        <option value=\"Pastor\">Pastor</option>\n        <option value=\"Bishop\">Bishop</option>\n        <option value=\"Apostle\">Apostle</option>\n        <option value=\"Elder\">Elder</option>\n        <option value=\"Founder\">Founder</option>\n      </select>\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Contact Email</label>\n      <input type=\"email\" id=\"field-email\" name=\"email\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"contact@church.org\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Phone</label>\n      <input type=\"tel\" id=\"field-phone\" name=\"phone\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"(555) 000-0000\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Address</label>\n      <textarea id=\"field-address\" name=\"address\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" rows=\"3\" placeholder=\"123 Main St, City, State 00000\"></textarea>\n    </div>\n              <div className=\"flex gap-3 mt-6\">\n                <button type=\"submit\" className=\"flex-1 bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition\">{editTarget ? \"Save Changes\" : \"Create Church\"}</button>\n                <button type=\"button\" onClick={closeOrganizationModal} className=\"px-4 py-2 border border-zinc-600 text-zinc-300 rounded-lg hover:bg-zinc-800 transition\">Cancel</button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n      {/* --- PHASE3_MODAL:org:END --- */}",
  "auth_guards": [
    "create:org WRITE",
    "update:org WRITE",
    "write:org"
  ]
}
