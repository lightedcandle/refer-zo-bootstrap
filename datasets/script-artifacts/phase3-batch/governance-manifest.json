{
  "entity": "GovernanceItem",
  "route": "/dashboard/governance",
  "slug": "governance",
  "label": "Governance Item",
  "field_count": 7,
  "fields": [
    "title",
    "type",
    "status",
    "owner",
    "dueDate",
    "description",
    "visibility"
  ],
  "state_var": "const [showGovernanceItemModal, setShowGovernanceItemModal] = useState(false);\n  const [editTarget, setEditTarget] = useState(null);",
  "functions": "  function openCreateGovernanceItem() {\n    setEditTarget(null);\n    setShowGovernanceItemModal(true);\n  }\n  function openEditGovernanceItem(item) {\n    setEditTarget(item);\n    setShowGovernanceItemModal(true);\n  }\n  function closeGovernanceItemModal() {\n    setShowGovernanceItemModal(false);\n    setEditTarget(null);\n  }",
  "button": "<button onClick={openCreateGovernanceItem} className=\"bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition\">+ Add Governance Item</button>",
  "modal_jsx": "{/* --- PHASE3_MODAL:governance:START --- */}\n      {showGovernanceItemModal && (\n        <div className=\"fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4\">\n          <div className=\"bg-zinc-900 border border-zinc-700 rounded-xl w-full max-w-lg max-h-[90vh] overflow-y-auto\">\n            <div className=\"flex items-center justify-between p-4 border-b border-zinc-700\">\n              <h2 className=\"text-lg font-semibold text-white\">{editTarget ? \"Edit Governance Item\" : \"Add Governance Item\"}</h2>\n              <button onClick={closeGovernanceItemModal} className=\"text-zinc-400 hover:text-white text-xl\">x</button>\n            </div>\n            <form onSubmit={(e) => { e.preventDefault(); closeGovernanceItemModal(); }} className=\"p-4\">\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Item Title *</label>\n      <input type=\"text\" id=\"field-title\" name=\"title\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"e.g. Motion: Approve 2026 Budget\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Item Type</label>\n      <select id=\"field-type\" name=\"type\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\">\n        <option value=\"\">Select...</option>\n        <option value=\"Motion\">Motion</option>\n        <option value=\"Vote\">Vote</option>\n        <option value=\"Decision\">Decision</option>\n        <option value=\"Amendment\">Amendment</option>\n        <option value=\"Dispute\">Dispute</option>\n        <option value=\"Policy Update\">Policy Update</option>\n      </select>\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Status</label>\n      <select id=\"field-status\" name=\"status\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\">\n        <option value=\"\">Select...</option>\n        <option value=\"Draft\">Draft</option>\n        <option value=\"Pending Vote\">Pending Vote</option>\n        <option value=\"Approved\">Approved</option>\n        <option value=\"Rejected\">Rejected</option>\n        <option value=\"Tabled\">Tabled</option>\n        <option value=\"Ratified\">Ratified</option>\n      </select>\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Item Owner / Sponsor</label>\n      <input type=\"text\" id=\"field-owner\" name=\"owner\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"e.g. Secretary / Board Chair\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Due Date</label>\n      <input type=\"date\" id=\"field-dueDate\" name=\"dueDate\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Description</label>\n      <textarea id=\"field-description\" name=\"description\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" rows=\"3\" placeholder=\"Details of the governance item...\"></textarea>\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Visibility</label>\n      <select id=\"field-visibility\" name=\"visibility\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\">\n        <option value=\"\">Select...</option>\n        <option value=\"All Members\">All Members</option>\n        <option value=\"Leaders Only\">Leaders Only</option>\n        <option value=\"Board Only\">Board Only</option>\n        <option value=\"Executive Only\">Executive Only</option>\n      </select>\n    </div>\n              <div className=\"flex gap-3 mt-6\">\n                <button type=\"submit\" className=\"flex-1 bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition\">{editTarget ? \"Save Changes\" : \"Create Governance Item\"}</button>\n                <button type=\"button\" onClick={closeGovernanceItemModal} className=\"px-4 py-2 border border-zinc-600 text-zinc-300 rounded-lg hover:bg-zinc-800 transition\">Cancel</button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n      {/* --- PHASE3_MODAL:governance:END --- */}",
  "auth_guards": [
    "create:governance WRITE",
    "update:governance WRITE",
    "write:governance"
  ]
}
