{
  "entity": "Initiative",
  "route": "/dashboard/initiatives",
  "slug": "initiative",
  "label": "Ministry",
  "field_count": 8,
  "fields": [
    "title",
    "type",
    "status",
    "owner",
    "churches",
    "goal",
    "startDate",
    "endDate"
  ],
  "state_var": "const [showInitiativeModal, setShowInitiativeModal] = useState(false);\n  const [editTarget, setEditTarget] = useState(null);",
  "functions": "  function openCreateInitiative() {\n    setEditTarget(null);\n    setShowInitiativeModal(true);\n  }\n  function openEditInitiative(item) {\n    setEditTarget(item);\n    setShowInitiativeModal(true);\n  }\n  function closeInitiativeModal() {\n    setShowInitiativeModal(false);\n    setEditTarget(null);\n  }",
  "button": "<button onClick={openCreateInitiative} className=\"bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition\">+ Add Ministry</button>",
  "modal_jsx": "{/* --- PHASE3_MODAL:initiative:START --- */}\n      {showInitiativeModal && (\n        <div className=\"fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4\">\n          <div className=\"bg-zinc-900 border border-zinc-700 rounded-xl w-full max-w-lg max-h-[90vh] overflow-y-auto\">\n            <div className=\"flex items-center justify-between p-4 border-b border-zinc-700\">\n              <h2 className=\"text-lg font-semibold text-white\">{editTarget ? \"Edit Ministry\" : \"Add Ministry\"}</h2>\n              <button onClick={closeInitiativeModal} className=\"text-zinc-400 hover:text-white text-xl\">x</button>\n            </div>\n            <form onSubmit={(e) => { e.preventDefault(); closeInitiativeModal(); }} className=\"p-4\">\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Ministry Title *</label>\n      <input type=\"text\" id=\"field-title\" name=\"title\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"e.g. Church Planting Initiative 2026\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Ministry Type</label>\n      <select id=\"field-type\" name=\"type\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\">\n        <option value=\"\">Select...</option>\n        <option value=\"Outreach\">Outreach</option>\n        <option value=\"Discipleship\">Discipleship</option>\n        <option value=\"Church Planting\">Church Planting</option>\n        <option value=\"Youth\">Youth</option>\n        <option value=\"Women\">Women</option>\n        <option value=\"Men\">Men</option>\n        <option value=\"Global Missions\">Global Missions</option>\n      </select>\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Status</label>\n      <select id=\"field-status\" name=\"status\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\">\n        <option value=\"\">Select...</option>\n        <option value=\"Active\">Active</option>\n        <option value=\"Planning\">Planning</option>\n        <option value=\"On-Hold\">On-Hold</option>\n        <option value=\"Completed\">Completed</option>\n      </select>\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Ministry Leader</label>\n      <input type=\"text\" id=\"field-owner\" name=\"owner\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"e.g. Apostle J\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Participating Churches</label>\n      <input type=\"text\" id=\"field-churches\" name=\"churches\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"e.g. Antioch, Grace, New Harvest\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Primary Goal</label>\n      <input type=\"text\" id=\"field-goal\" name=\"goal\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"e.g. Plant 5 new churches by 2027\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Start Date</label>\n      <input type=\"date\" id=\"field-startDate\" name=\"startDate\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Target End Date</label>\n      <input type=\"date\" id=\"field-endDate\" name=\"endDate\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"\" />\n    </div>\n              <div className=\"flex gap-3 mt-6\">\n                <button type=\"submit\" className=\"flex-1 bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition\">{editTarget ? \"Save Changes\" : \"Create Ministry\"}</button>\n                <button type=\"button\" onClick={closeInitiativeModal} className=\"px-4 py-2 border border-zinc-600 text-zinc-300 rounded-lg hover:bg-zinc-800 transition\">Cancel</button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n      {/* --- PHASE3_MODAL:initiative:END --- */}",
  "auth_guards": [
    "create:initiative WRITE",
    "update:initiative WRITE",
    "write:initiative"
  ]
}
