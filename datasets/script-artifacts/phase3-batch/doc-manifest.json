{
  "entity": "Document",
  "route": "/dashboard/documents",
  "slug": "doc",
  "label": "Document",
  "field_count": 6,
  "fields": [
    "title",
    "category",
    "privacy",
    "effectiveDate",
    "owner",
    "description"
  ],
  "state_var": "const [showDocumentModal, setShowDocumentModal] = useState(false);\n  const [editTarget, setEditTarget] = useState(null);",
  "functions": "  function openCreateDocument() {\n    setEditTarget(null);\n    setShowDocumentModal(true);\n  }\n  function openEditDocument(item) {\n    setEditTarget(item);\n    setShowDocumentModal(true);\n  }\n  function closeDocumentModal() {\n    setShowDocumentModal(false);\n    setEditTarget(null);\n  }",
  "button": "<button onClick={openCreateDocument} className=\"bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition\">+ Add Document</button>",
  "modal_jsx": "{/* --- PHASE3_MODAL:doc:START --- */}\n      {showDocumentModal && (\n        <div className=\"fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4\">\n          <div className=\"bg-zinc-900 border border-zinc-700 rounded-xl w-full max-w-lg max-h-[90vh] overflow-y-auto\">\n            <div className=\"flex items-center justify-between p-4 border-b border-zinc-700\">\n              <h2 className=\"text-lg font-semibold text-white\">{editTarget ? \"Edit Document\" : \"Add Document\"}</h2>\n              <button onClick={closeDocumentModal} className=\"text-zinc-400 hover:text-white text-xl\">x</button>\n            </div>\n            <form onSubmit={(e) => { e.preventDefault(); closeDocumentModal(); }} className=\"p-4\">\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Document Title *</label>\n      <input type=\"text\" id=\"field-title\" name=\"title\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"e.g. Alliance Bylaws 2026\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Category</label>\n      <select id=\"field-category\" name=\"category\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\">\n        <option value=\"\">Select...</option>\n        <option value=\"Charter\">Charter</option>\n        <option value=\"Policy\">Policy</option>\n        <option value=\"Report\">Report</option>\n        <option value=\"Minutes\">Minutes</option>\n        <option value=\"Template\">Template</option>\n        <option value=\"Covenant\">Covenant</option>\n        <option value=\"Doctrine\">Doctrine</option>\n        <option value=\"Compliance\">Compliance</option>\n      </select>\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Privacy Tier</label>\n      <select id=\"field-privacy\" name=\"privacy\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\">\n        <option value=\"\">Select...</option>\n        <option value=\"Public\">Public</option>\n        <option value=\"Members Only\">Members Only</option>\n        <option value=\"Leaders Only\">Leaders Only</option>\n        <option value=\"Board Only\">Board Only</option>\n        <option value=\"Executive Only\">Executive Only</option>\n      </select>\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Effective Date</label>\n      <input type=\"date\" id=\"field-effectiveDate\" name=\"effectiveDate\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Document Owner</label>\n      <input type=\"text\" id=\"field-owner\" name=\"owner\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"e.g. Secretary / Apostle J\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Description / Summary</label>\n      <textarea id=\"field-description\" name=\"description\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" rows=\"3\" placeholder=\"Brief description of the document...\"></textarea>\n    </div>\n              <div className=\"flex gap-3 mt-6\">\n                <button type=\"submit\" className=\"flex-1 bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition\">{editTarget ? \"Save Changes\" : \"Create Document\"}</button>\n                <button type=\"button\" onClick={closeDocumentModal} className=\"px-4 py-2 border border-zinc-600 text-zinc-300 rounded-lg hover:bg-zinc-800 transition\">Cancel</button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n      {/* --- PHASE3_MODAL:doc:END --- */}",
  "auth_guards": [
    "create:doc WRITE",
    "update:doc WRITE",
    "write:doc"
  ]
}
