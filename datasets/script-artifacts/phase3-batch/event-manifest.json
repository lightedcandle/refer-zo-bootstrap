{
  "entity": "Event",
  "route": "/dashboard/calendar",
  "slug": "event",
  "label": "Event",
  "field_count": 8,
  "fields": [
    "title",
    "type",
    "startDate",
    "endDate",
    "location",
    "audience",
    "capacity",
    "registration"
  ],
  "state_var": "const [showEventModal, setShowEventModal] = useState(false);\n  const [editTarget, setEditTarget] = useState(null);",
  "functions": "  function openCreateEvent() {\n    setEditTarget(null);\n    setShowEventModal(true);\n  }\n  function openEditEvent(item) {\n    setEditTarget(item);\n    setShowEventModal(true);\n  }\n  function closeEventModal() {\n    setShowEventModal(false);\n    setEditTarget(null);\n  }",
  "button": "<button onClick={openCreateEvent} className=\"bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition\">+ Add Event</button>",
  "modal_jsx": "{/* --- PHASE3_MODAL:event:START --- */}\n      {showEventModal && (\n        <div className=\"fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4\">\n          <div className=\"bg-zinc-900 border border-zinc-700 rounded-xl w-full max-w-lg max-h-[90vh] overflow-y-auto\">\n            <div className=\"flex items-center justify-between p-4 border-b border-zinc-700\">\n              <h2 className=\"text-lg font-semibold text-white\">{editTarget ? \"Edit Event\" : \"Add Event\"}</h2>\n              <button onClick={closeEventModal} className=\"text-zinc-400 hover:text-white text-xl\">x</button>\n            </div>\n            <form onSubmit={(e) => { e.preventDefault(); closeEventModal(); }} className=\"p-4\">\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Event Name *</label>\n      <input type=\"text\" id=\"field-title\" name=\"title\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"e.g. Annual Ministers Conference 2026\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Event Type</label>\n      <select id=\"field-type\" name=\"type\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\">\n        <option value=\"\">Select...</option>\n        <option value=\"Conference\">Conference</option>\n        <option value=\"Meeting\">Meeting</option>\n        <option value=\"Training\">Training</option>\n        <option value=\"Worship\">Worship</option>\n        <option value=\"Regional Rally\">Regional Rally</option>\n        <option value=\"Board Meeting\">Board Meeting</option>\n      </select>\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Start Date *</label>\n      <input type=\"date\" id=\"field-startDate\" name=\"startDate\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">End Date</label>\n      <input type=\"date\" id=\"field-endDate\" name=\"endDate\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Location</label>\n      <input type=\"text\" id=\"field-location\" name=\"location\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"e.g. Telechurch Studio or City, State\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Audience</label>\n      <select id=\"field-audience\" name=\"audience\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\">\n        <option value=\"\">Select...</option>\n        <option value=\"All Churches\">All Churches</option>\n        <option value=\"Pastors Only\">Pastors Only</option>\n        <option value=\"Leaders Only\">Leaders Only</option>\n        <option value=\"General Assembly\">General Assembly</option>\n        <option value=\"Board Only\">Board Only</option>\n      </select>\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Capacity</label>\n      <input type=\"number\" id=\"field-capacity\" name=\"capacity\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"e.g. 150\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Registration Required</label>\n      <select id=\"field-registration\" name=\"registration\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\">\n        <option value=\"\">Select...</option>\n        <option value=\"Yes - RSVP Required\">Yes - RSVP Required</option>\n        <option value=\"No - Open\">No - Open</option>\n        <option value=\"By Invitation\">By Invitation</option>\n      </select>\n    </div>\n              <div className=\"flex gap-3 mt-6\">\n                <button type=\"submit\" className=\"flex-1 bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition\">{editTarget ? \"Save Changes\" : \"Create Event\"}</button>\n                <button type=\"button\" onClick={closeEventModal} className=\"px-4 py-2 border border-zinc-600 text-zinc-300 rounded-lg hover:bg-zinc-800 transition\">Cancel</button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n      {/* --- PHASE3_MODAL:event:END --- */}",
  "auth_guards": [
    "create:event WRITE",
    "update:event WRITE",
    "write:event"
  ]
}
