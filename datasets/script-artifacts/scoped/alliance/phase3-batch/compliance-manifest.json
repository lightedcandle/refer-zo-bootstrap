{
  "entity": "ComplianceTask",
  "route": "/dashboard/compliance",
  "slug": "compliance",
  "label": "Compliance Task",
  "field_count": 6,
  "fields": [
    "title",
    "organization",
    "standard",
    "status",
    "dueDate",
    "description"
  ],
  "state_var": "const [showComplianceTaskModal, setShowComplianceTaskModal] = useState(false);\n  const [editTarget, setEditTarget] = useState(null);",
  "functions": "  function openCreateComplianceTask() {\n    setEditTarget(null);\n    setShowComplianceTaskModal(true);\n  }\n  function openEditComplianceTask(item) {\n    setEditTarget(item);\n    setShowComplianceTaskModal(true);\n  }\n  function closeComplianceTaskModal() {\n    setShowComplianceTaskModal(false);\n    setEditTarget(null);\n  }",
  "button": "<button onClick={openCreateComplianceTask} className=\"bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition\">+ Add Compliance Task</button>",
  "modal_jsx": "{/* --- PHASE3_MODAL:compliance:START --- */}\n      {showComplianceTaskModal && (\n        <div className=\"fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4\">\n          <div className=\"bg-zinc-900 border border-zinc-700 rounded-xl w-full max-w-lg max-h-[90vh] overflow-y-auto\">\n            <div className=\"flex items-center justify-between p-4 border-b border-zinc-700\">\n              <h2 className=\"text-lg font-semibold text-white\">{editTarget ? \"Edit Compliance Task\" : \"Add Compliance Task\"}</h2>\n              <button onClick={closeComplianceTaskModal} className=\"text-zinc-400 hover:text-white text-xl\">x</button>\n            </div>\n            <form onSubmit={(e) => { e.preventDefault(); closeComplianceTaskModal(); }} className=\"p-4\">\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Task Title *</label>\n      <input type=\"text\" id=\"field-title\" name=\"title\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"e.g. Submit Annual Credentialing Report\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Church / Organization</label>\n      <input type=\"text\" id=\"field-organization\" name=\"organization\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"e.g. Antioch Fellowship\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Standard / Requirement</label>\n      <select id=\"field-standard\" name=\"standard\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\">\n        <option value=\"\">Select...</option>\n        <option value=\"Credentialing\">Credentialing</option>\n        <option value=\"Annual Report\">Annual Report</option>\n        <option value=\"Doctrine Alignment\">Doctrine Alignment</option>\n        <option value=\"Financial Disclosure\">Financial Disclosure</option>\n        <option value=\"Safeguarding Policy\">Safeguarding Policy</option>\n      </select>\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Status</label>\n      <select id=\"field-status\" name=\"status\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\">\n        <option value=\"\">Select...</option>\n        <option value=\"Pending\">Pending</option>\n        <option value=\"In Progress\">In Progress</option>\n        <option value=\"Submitted\">Submitted</option>\n        <option value=\"Approved\">Approved</option>\n        <option value=\"Non-Compliant\">Non-Compliant</option>\n        <option value=\"Exempt\">Exempt</option>\n      </select>\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Due Date *</label>\n      <input type=\"date\" id=\"field-dueDate\" name=\"dueDate\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Evidence / Notes</label>\n      <textarea id=\"field-description\" name=\"description\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" rows=\"3\" placeholder=\"Supporting notes or evidence of compliance...\"></textarea>\n    </div>\n              <div className=\"flex gap-3 mt-6\">\n                <button type=\"submit\" className=\"flex-1 bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition\">{editTarget ? \"Save Changes\" : \"Create Compliance Task\"}</button>\n                <button type=\"button\" onClick={closeComplianceTaskModal} className=\"px-4 py-2 border border-zinc-600 text-zinc-300 rounded-lg hover:bg-zinc-800 transition\">Cancel</button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n      {/* --- PHASE3_MODAL:compliance:END --- */}",
  "auth_guards": [
    "create:compliance WRITE",
    "update:compliance WRITE",
    "write:compliance"
  ]
}
