{
  "entity": "Person",
  "route": "/dashboard/people",
  "slug": "person",
  "label": "Person",
  "field_count": 8,
  "fields": [
    "fullName",
    "title",
    "email",
    "phone",
    "church",
    "region",
    "lifecycle",
    "ordinationDate"
  ],
  "state_var": "const [showPersonModal, setShowPersonModal] = useState(false);\n  const [editTarget, setEditTarget] = useState(null);",
  "functions": "  function openCreatePerson() {\n    setEditTarget(null);\n    setShowPersonModal(true);\n  }\n  function openEditPerson(item) {\n    setEditTarget(item);\n    setShowPersonModal(true);\n  }\n  function closePersonModal() {\n    setShowPersonModal(false);\n    setEditTarget(null);\n  }",
  "button": "<button onClick={openCreatePerson} className=\"bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition\">+ Add Person</button>",
  "modal_jsx": "{/* --- PHASE3_MODAL:person:START --- */}\n      {showPersonModal && (\n        <div className=\"fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4\">\n          <div className=\"bg-zinc-900 border border-zinc-700 rounded-xl w-full max-w-lg max-h-[90vh] overflow-y-auto\">\n            <div className=\"flex items-center justify-between p-4 border-b border-zinc-700\">\n              <h2 className=\"text-lg font-semibold text-white\">{editTarget ? \"Edit Person\" : \"Add Person\"}</h2>\n              <button onClick={closePersonModal} className=\"text-zinc-400 hover:text-white text-xl\">x</button>\n            </div>\n            <form onSubmit={(e) => { e.preventDefault(); closePersonModal(); }} className=\"p-4\">\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Full Name *</label>\n      <input type=\"text\" id=\"field-fullName\" name=\"fullName\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"e.g. Rev. Mary Thomas\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Title / Role</label>\n      <select id=\"field-title\" name=\"title\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\">\n        <option value=\"\">Select...</option>\n        <option value=\"Pastor\">Pastor</option>\n        <option value=\"Bishop\">Bishop</option>\n        <option value=\"Elder\">Elder</option>\n        <option value=\"Deacon\">Deacon</option>\n        <option value=\"Secretary\">Secretary</option>\n        <option value=\"Apostle\">Apostle</option>\n        <option value=\"Member\">Member</option>\n      </select>\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Email</label>\n      <input type=\"email\" id=\"field-email\" name=\"email\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"pastor@church.org\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Phone</label>\n      <input type=\"tel\" id=\"field-phone\" name=\"phone\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"(555) 000-0000\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Church / Organization</label>\n      <input type=\"text\" id=\"field-church\" name=\"church\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"e.g. Antioch Fellowship\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Region</label>\n      <input type=\"text\" id=\"field-region\" name=\"region\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"e.g. Northeast\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Lifecycle Status</label>\n      <select id=\"field-lifecycle\" name=\"lifecycle\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\">\n        <option value=\"\">Select...</option>\n        <option value=\"Active\">Active</option>\n        <option value=\"On-Leave\">On-Leave</option>\n        <option value=\"Transitioning\">Transitioning</option>\n        <option value=\"Inactive\">Inactive</option>\n        <option value=\"Ordained\">Ordained</option>\n        <option value=\"Licensed\">Licensed</option>\n        <option value=\"Candidate\">Candidate</option>\n      </select>\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Ordination Date</label>\n      <input type=\"date\" id=\"field-ordinationDate\" name=\"ordinationDate\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"\" />\n    </div>\n              <div className=\"flex gap-3 mt-6\">\n                <button type=\"submit\" className=\"flex-1 bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition\">{editTarget ? \"Save Changes\" : \"Create Person\"}</button>\n                <button type=\"button\" onClick={closePersonModal} className=\"px-4 py-2 border border-zinc-600 text-zinc-300 rounded-lg hover:bg-zinc-800 transition\">Cancel</button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n      {/* --- PHASE3_MODAL:person:END --- */}",
  "auth_guards": [
    "create:person WRITE",
    "update:person WRITE",
    "write:person"
  ]
}
