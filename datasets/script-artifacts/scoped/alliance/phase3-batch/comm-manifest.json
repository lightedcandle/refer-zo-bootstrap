{
  "entity": "Communication",
  "route": "/dashboard/communications",
  "slug": "comm",
  "label": "Communication",
  "field_count": 7,
  "fields": [
    "title",
    "type",
    "status",
    "audience",
    "approvedBy",
    "scheduledDate",
    "summary"
  ],
  "state_var": "const [showCommunicationModal, setShowCommunicationModal] = useState(false);\n  const [editTarget, setEditTarget] = useState(null);",
  "functions": "  function openCreateCommunication() {\n    setEditTarget(null);\n    setShowCommunicationModal(true);\n  }\n  function openEditCommunication(item) {\n    setEditTarget(item);\n    setShowCommunicationModal(true);\n  }\n  function closeCommunicationModal() {\n    setShowCommunicationModal(false);\n    setEditTarget(null);\n  }",
  "button": "<button onClick={openCreateCommunication} className=\"bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition\">+ Add Communication</button>",
  "modal_jsx": "{/* --- PHASE3_MODAL:comm:START --- */}\n      {showCommunicationModal && (\n        <div className=\"fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4\">\n          <div className=\"bg-zinc-900 border border-zinc-700 rounded-xl w-full max-w-lg max-h-[90vh] overflow-y-auto\">\n            <div className=\"flex items-center justify-between p-4 border-b border-zinc-700\">\n              <h2 className=\"text-lg font-semibold text-white\">{editTarget ? \"Edit Communication\" : \"Add Communication\"}</h2>\n              <button onClick={closeCommunicationModal} className=\"text-zinc-400 hover:text-white text-xl\">x</button>\n            </div>\n            <form onSubmit={(e) => { e.preventDefault(); closeCommunicationModal(); }} className=\"p-4\">\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Communication Title *</label>\n      <input type=\"text\" id=\"field-title\" name=\"title\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"e.g. June Newsletter\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Channel / Type</label>\n      <select id=\"field-type\" name=\"type\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\">\n        <option value=\"\">Select...</option>\n        <option value=\"Email\">Email</option>\n        <option value=\"SMS\">SMS</option>\n        <option value=\"Letter\">Letter</option>\n        <option value=\"Announcement\">Announcement</option>\n        <option value=\"Pastoral Letter\">Pastoral Letter</option>\n        <option value=\"Public Statement\">Public Statement</option>\n      </select>\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Status</label>\n      <select id=\"field-status\" name=\"status\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\">\n        <option value=\"\">Select...</option>\n        <option value=\"Draft\">Draft</option>\n        <option value=\"Pending Approval\">Pending Approval</option>\n        <option value=\"Approved\">Approved</option>\n        <option value=\"Scheduled\">Scheduled</option>\n        <option value=\"Sent\">Sent</option>\n        <option value=\"Archived\">Archived</option>\n      </select>\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Target Audience</label>\n      <select id=\"field-audience\" name=\"audience\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\">\n        <option value=\"\">Select...</option>\n        <option value=\"All Churches\">All Churches</option>\n        <option value=\"Pastors Only\">Pastors Only</option>\n        <option value=\"Leaders Only\">Leaders Only</option>\n        <option value=\"General Assembly\">General Assembly</option>\n        <option value=\"Board Only\">Board Only</option>\n        <option value=\"Public\">Public</option>\n      </select>\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Approved By</label>\n      <input type=\"text\" id=\"field-approvedBy\" name=\"approvedBy\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"e.g. Apostle J\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Scheduled Date</label>\n      <input type=\"date\" id=\"field-scheduledDate\" name=\"scheduledDate\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" placeholder=\"\" />\n    </div>\n    <div className=\"mb-4\">\n      <label className=\"block text-sm font-medium text-zinc-300 mb-1\">Message Summary</label>\n      <textarea id=\"field-summary\" name=\"summary\" className=\"w-full bg-zinc-800 border border-zinc-600 rounded-lg px-3 py-2 text-white focus:border-blue-500 focus:outline-none\" rows=\"3\" placeholder=\"Brief summary of the communication content...\"></textarea>\n    </div>\n              <div className=\"flex gap-3 mt-6\">\n                <button type=\"submit\" className=\"flex-1 bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition\">{editTarget ? \"Save Changes\" : \"Create Communication\"}</button>\n                <button type=\"button\" onClick={closeCommunicationModal} className=\"px-4 py-2 border border-zinc-600 text-zinc-300 rounded-lg hover:bg-zinc-800 transition\">Cancel</button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n      {/* --- PHASE3_MODAL:comm:END --- */}",
  "auth_guards": [
    "create:comm WRITE",
    "update:comm WRITE",
    "write:comm"
  ]
}
