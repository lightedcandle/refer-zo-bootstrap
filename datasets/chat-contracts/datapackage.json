{
  "name": "chat-contracts",
  "id": "chat-contracts",
  "version": "1.0.0",
  "description": "Logs every intake contract, chunk session, and routing decision from compress-prompt.mjs. Primary audit trail for factory routing analytics.",
  "keywords": ["refer", "intake", "contracts", "audit"],
  "resources": [
    {
      "path": "data.duckdb",
      "name": "contracts",
      "format": "duckdb",
      "schema": "contracts"
    },
    {
      "path": "data.duckdb",
      "name": "chunks",
      "format": "duckdb",
      "schema": "chunks"
    }
  ],
  "schemas": {
    "contracts": {
      "fields": [
        { "name": "id",              "type": "string",  "description": "Unique contract ID, format: contract_<timestamp>_<random>" },
        { "name": "session_id",       "type": "string",  "description": "Chunk session this contract belongs to" },
        { "name": "prompt",          "type": "string",  "description": "Original human prompt" },
        { "name": "mode",            "type": "string",  "description": "DISCUSS | BUILD | MICRO | PLAN" },
        { "name": "risk",            "type": "string",  "description": "bounded | risky | unknown" },
        { "name": "chunk_count",      "type": "integer", "description": "Number of chunks (1 = no chunking)" },
        { "name": "chunk_ids",        "type": "string",  "description": "Comma-separated chunk IDs, NULL if not chunked" },
        { "name": "matched_script",   "type": "string",  "description": "Script ID if matched, NULL otherwise" },
        { "name": "needs_chunking",   "type": "boolean", "description": "True if prompt was auto-chunked" },
        { "name": "outcome",          "type": "string",  "description": "ok | skipped | error" },
        { "name": "status",           "type": "string",  "description": "pending | in_progress | done | failed" },
        { "name": "created_at",       "type": "string",  "description": "ISO 8601 timestamp of contract creation" }
      ]
    },
    "chunks": {
      "fields": [
        { "name": "id",              "type": "string",  "description": "Chunk ID, format: chunk_<timestamp>_<random>" },
        { "name": "session_id",     "type": "string",  "description": "Parent chunk session ID" },
        { "name": "index",          "type": "integer", "description": "0-based position within session" },
        { "name": "text",           "type": "string",  "description": "The chunked prompt text" },
        { "name": "words",          "type": "integer", "description": "Word count of this chunk" },
        { "name": "status",          "type": "string",  "description": "pending | in_flight | done | error | timeout" },
        { "name": "created_at",      "type": "string",  "description": "ISO 8601 timestamp" }
      ]
    }
  },
  "metadata": {
    "created_at": "2026-04-28",
    "maintained_by": "compress-prompt.mjs",
    "read_by": ["talkback.mjs", "dispatcher.mjs", "hive/api.mjs"]
  }
}
