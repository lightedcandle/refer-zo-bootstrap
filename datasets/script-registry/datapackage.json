{
  "name": "script-registry",
  "id": "script-registry",
  "version": "1.0.0",
  "description": "DuckDB mirror of script-registry.json with run history, stats, and performance data. Updated by heartbeat.mjs train cars. Used for trigger matching and detecting broken or unused scripts.",
  "keywords": ["scripts", "registry", "forge", "tracker"],
  "resources": [
    { "path": "data.duckdb", "name": "scripts", "format": "duckdb", "schema": "scripts" },
    { "path": "data.duckdb", "name": "runs",    "format": "duckdb", "schema": "runs" }
  ],
  "schemas": {
    "scripts": {
      "fields": [
        { "name": "id",              "type": "string",  "description": "Forge ID, matches script-registry.json" },
        { "name": "name",           "type": "string",  "description": "Human-readable forge name" },
        { "name": "type",           "type": "string",  "description": "forge | gate | intake" },
        { "name": "description",     "type": "string",  "description": "What this forge does" },
        { "name": "trigger_intents", "type": "string",  "description": "Comma-separated trigger phrases for matching" },
        { "name": "status",         "type": "string",  "description": "active | deprecated | broken" },
        { "name": "version",        "type": "string",  "description": "Semantic version of this script" },
        { "name": "requires_ai",     "type": "boolean", "description": "True if this script requires AI reasoning" },
        { "name": "script_file",     "type": "string",  "description": "Relative path to the script file" },
        { "name": "last_run_at",     "type": "string",  "description": "ISO 8601 of most recent run" },
        { "name": "run_count",       "type": "integer", "description": "Total number of times this script has run" },
        { "name": "avg_duration_ms", "type": "integer", "description": "Average execution duration in milliseconds" }
      ]
    },
    "runs": {
      "fields": [
        { "name": "id",             "type": "string",  "description": "Run UUID" },
        { "name": "script_id",     "type": "string",  "description": "Reference to scripts.id" },
        { "name": "outcome",       "type": "string",  "description": "ok | skipped | error" },
        { "name": "duration_ms",   "type": "integer", "description": "Execution time in milliseconds" },
        { "name": "inputs",        "type": "string",  "description": "JSON string of input parameters" },
        { "name": "outputs",       "type": "string",  "description": "JSON string of output values" },
        { "name": "created_at",     "type": "string",  "description": "ISO 8601 timestamp of run" }
      ]
    }
  },
  "metadata": {
    "created_at": "2026-04-28",
    "maintained_by": "heartbeat.mjs | scan-workspace.mjs",
    "read_by": ["compress-prompt.mjs", "talkback.mjs", "hive/api.mjs"]
  }
}
