{
  "library_name": "refer-skill-library",
  "library_version": "0.2.0",
  "refer_version": "0.2.0",
  "update_channel": "stable",
  "released_at": "2026-04-24",
  "hub_description": "REFER is a reference-first operating system and skill library for Zo. It turns normal chat into governed execution by interpreting intent through one canonical router, keeping work aligned to law and referenced truth instead of drift, contradiction, or ad hoc building.",
  "hub_icon": "anchor",
  "credit_attribution": {
    "name": "REFER.OS",
    "author_name": "Calvin Anderson",
    "author_alias": "ApostleJ",
    "author_site": "https://telechurchlive.com",
    "summary": "REFER.OS reference-first governance and skill system for Zo.",
    "attribution": "Built from REFER.OS governance and routed workflow doctrine by Calvin Anderson (ApostleJ), adapted into Zo-native skills for Telechurch tandem operation."
  },
  "bootstrap_skill": "refer-library-bootstrap",
  "entry_skill": "refer-os",
  "startup_binding_required": true,
  "startup_binding_version": 1,
  "active_runtime_root": "/home/workspace/Skills",
  "portable_library_root": "refer-zo-bootstrap/skills",
  "authority_roots": [
    "/home/workspace/REFER.OS",
    "/home/workspace/agent.md",
    "/home/workspace/AGENTS.md",
    "/home/workspace/Skills",
    "/home/workspace/<PROFILE>"
  ],
  "universal_skills": [
    "refer-os",
    "refer-zo-intake-router",
    "refer-governance",
    "refer-contract-tandem",
    "refer-library-bootstrap",
    "refer-vipc-build-director",
    "refer-vipc-operator-driver",
    "refer-vipc-design-driver"
  ],
  "prompt_policy": {
    "default": "prompt_if_behind",
    "critical": "prompt_priority",
    "mid_session": "do_not_force",
    "options": [
      "update_now",
      "remind_later",
      "skip_this_version"
    ]
  },
  "packages": [
    {
      "name": "refer-law",
      "type": "skill-rule-stack",
      "description": "Governance rules, skills, and law files that govern AI operation on Zo. Installs as Zo Skills.",
      "install_path": "Skills/",
      "contains": [
        "skills/refer-os",
        "skills/refer-zo-intake-router",
        "skills/refer-governance",
        "skills/refer-contract-tandem",
        "skills/refer-library-bootstrap",
        "skills/refer-vipc-operator-driver",
        "skills/refer-vipc-design-driver",
        "skills/refer-vipc-build-director",
        "skills/zo-design-driver",
        "skills/zo-free-tier-platform-limits"
      ],
      "installer": "tools/vipc-bootstrap.mjs",
      "distribution": "github+zo-skills"
    },
    {
      "name": "script-factory",
      "type": "autonomous-living-skill",
      "description": "Self-evolving Script Factory with heartbeat, gap scanning, and Hive inter-node communication. Ships with DISCUSS/BUILD/MICRO modes.",
      "install_path": "refer-factory/",
      "contains": [
        "scripts/factory/factory.mjs",
        "scripts/factory/heartbeat.mjs",
        "scripts/factory/intake-engine.mjs",
        "scripts/factory/decompress.mjs",
        "scripts/factory/emit-contract.mjs",
        "scripts/factory/scan-workspace.mjs",
        "scripts/factory/register-artifact.mjs",
        "scripts/factory/sync-skill.mjs",
        "scripts/factory/bootstrap.mjs",
        "scripts/factory/interlink.mjs",
        "scripts/factory/cars/",
        "scripts/factory/hive/talkback.mjs",
        "scripts/factory/hive/nodes.json",
        "scripts/factory/hive/self.json"
      ],
      "installer": "scripts/factory/bootstrap.mjs",
      "distribution": "github-only"
    }
  ]
}
